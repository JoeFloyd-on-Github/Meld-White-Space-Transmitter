#!/bin/sh

METHOD=auto
DHCP=0
IPADDR=192.168.1.194
SUBNET=255.255.255.0
GATEWAY=192.168.1.254

if [ $DHCP == 1 ]; then
  echo "Using DHCP"
  killall udhcpc
  udhcpc -i eth0 -h $HOSTNAME -p /usr/share/udhcpc.eth0.pid -b
else
  echo "Using Static IP Configuration"
  ifconfig eth0 $IPADDR netmask $SUBNET up
  route add default gw $GATEWAY eth0
fi
sync
ping -c 1 -W 5 $GATEWAY


#	clear_config_files - $Revision: 11 $ $Date: 2012-08-09 15:11:41 -0400 (Thu, 09 Aug 2012) $ $Author: mario $
#	This script clears the values for the status web page		#
#	This script needs to be called in /etc/init.d/rcS		#


sed -i "s/option.*/option 'channels' ''/" /etc/config/channels
sed -i "s/option.*/option 'channel' ''/" /etc/config/operating
sed -i "s/option.*/option 'status' ''/" /etc/config/channel_status
sed -i "s/option.*/option 'status' ''/" /etc/config/transmitter

#       xml_conversion - $Revision: 11 $ $Date: 2012-08-09 15:11:41 -0400 (Thu, 09 Aug 2012) $ $Author: mario $
#       This script converts a config file to XML by supplying a	#
#	template XML file						#
#       This script needs to be called in /disk/usr/bin/wsagent_start            #

# USAGE: awk -f <awk-script> <source-file> <xml-template> > <xml-file>

BEGIN {
  FS = "'";
}

FNR == NR {
  a[$2] = $4;
  next;
}

/<[^>]*>.*<\/[^>]*>/ {
  split($0, b, /[<>]/);

  if (b[2] in a) {
    printf("%s<%s>%s<%s>\n", b[1], b[2], a[b[2]], b[4]);
  }

  next;
}

{
  print;
}

#       wsagent_start - $Revision: 11 $ $Date: 2012-08-09 15:11:41 -0400 (Thu, 09 Aug 2012) $ $Author: mario $
#       This script converts the registration information into          #
#	XML and starts the whitespaceagent process			#
#       This script needs to be called in /etc/init.d/rcS to start	#
#	on device boot and also in /disk/www/registration.php		#

# CONVERT CONFIG FILE INTO XML FILE
# USAGE: awk -f <awk-script> <source-file> <xml-template> > <xml-file>
/usr/bin/awk -f /disk/usr/bin/xml_conversion /etc/config/sbi /etc/config/template_file > /etc/config/meldTechDeviceCapability.xml 

# Added July 28, 2013
# The whitespaceagent needs to have the serial buffer cleared before execution
stty -F /dev/ttyS1 -echo -onlcr
# START THE WHITE SPACE AGENT
# USAGE ./whitespaceagent <certificat-file> <certificate-path> <xml-file> 2>&1 > /dev/null &
# NOTE, had to get rid of 2>&1 because it was hanging thttpd
#/disk/usr/bin/whitespaceagent cafile.cert /etc/config /etc/config/meldTechDeviceCapability.xml > /dev/null &
/disk/usr/bin/whitespaceagent cafile.cert /etc/config /etc/config/meldTechDeviceCapability.xml > /disk/usr/bin/test.log &

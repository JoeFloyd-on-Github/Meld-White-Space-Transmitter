pq_64bit_num2bin(num,bytes) long_long_to_bytes(num, bytes)
pq_64bit_get_word(x) *(x)
pq_64bit_lshift(r,x,shift) (*(r) = (*(x) << (shift)))
pq_64bit_set_bit(x,num) do { PQ_64BIT mask = 1; mask = mask << (num); *(x) |= mask; } while(0)

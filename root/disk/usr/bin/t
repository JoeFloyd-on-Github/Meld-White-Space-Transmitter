pq_64bit_assign(x,y) (*(x) = *(y))
pq_64bit_assign_word(x,y) (*(x) = y)
pq_64bit_gt(x,y) (*(x) > *(y))
pq_64bit_eq(x,y) (*(x) == *(y))
pq_64bit_add_word(x,w) (*(x) = (*(x) + (w)))
pq_64bit_sub(r,x,y) (*(r) = (*(x) - *(y)))
pq_64bit_sub_word(x,w) (*(x) = (*(x) - (w)))
pq_64bit_mod(r,x,n,ctx) 

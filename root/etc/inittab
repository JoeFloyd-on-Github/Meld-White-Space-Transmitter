# Boot-time system configuration/initialization script.
#
::sysinit:/etc/init.d/rcS

# Start an shell on the console, use hack to stdin/stdout opened to /dev/console
#::respawn:/bin/cttyhack /bin/sh
#ttyS0::askfirst:/bin/sh

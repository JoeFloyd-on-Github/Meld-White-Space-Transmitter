#!/bin/sh
trap "" SIGHUP
echo "Mounting proc"
mount -t proc none /proc
echo "Mounting usbfs"
mount -t usbfs none /proc/bus/usb
echo "Mounting sysfs"
mount -t sysfs none /sys

#Mount Read Only Nand FS
/bin/actimage
actimg=$?
echo "Active image:${actimg}"
if [ ${actimg} == 0 ]; then
	mount -t yaffs2 -rw /dev/mtdblock8 /disk
elif [ ${actimg} == 1 ]; then 
	echo "mount nand /dev/mtdblock9 to /disk"
	mount -t yaffs2 -rw /dev/mtdblock9 /disk
else
	echo "Error:can't get the active image"
	exit 1
fi

echo "Starting uevent daemon"
/usr/bin/uevent_daemon

echo "Starting Udev"
start_udev

echo "Mounting devpts"
mount -t devpts none /dev/pts

sysctl -p

export HOSTNAME="xc4viper"
echo "Setting hostname $HOSTNAME"
hostname $HOSTNAME

echo "Bringing up loopback device"
ifconfig lo 127.0.0.1 netmask 255.0.0.0 up
route add -net 127.0.0.0 netmask 255.0.0.0 dev lo

echo "Bringing up Eth0"
#ifconfig eth0 172.19.4.198 netmask 255.255.0.0 up
#route add default gw 172.19.1.1 eth0
#udhcpc -i eth0 -h $HOSTNAME -b
/etc/init.d/setipeth0

#echo "Bringing up Eth1"
#ifconfig eth0 192.168.10.200 netmask 255.255.255.0 up
#route add default gw 172.18.1.1 eth1
#udhcpc -i eth1 -h $HOSTNAME -b
#/etc/init.d/setipeth1

#echo "Mounting NFS"
#mount -t nfs -o nolock 172.18.3.195:/root /nfs

#echo "Starting System logger (syslogd)"
#syslogd -O /nfs/var/log/messages 
#echo "Starting Kernel logger (klogd)"
#klogd

#Mount SPI File System if fail 
#mount -t jffs2 /dev/mtdblock11 /spi_disk
#if [ $? != 0 ]; then
#	flash_erase -j /dev/mtd11 0 0
#	mount -t jffs2 /dev/mtdblock11 /spi_disk
#	mkdir -p /spi_disk/pstor
#fi

echo "Starting Telnet Daemon"
telnetd -l /bin/sh

#echo "Increase Ethernet RX buffer"
#sysctl -p

#echo "Starting Web Server (Boa)"
#boa -c /etc/boa
#echo "Starting inetd"
#inetd

#echo "Enabing DMA mode of IDE driver"
#hdparm -d1 /dev/hda

#echo "Starting Samba server"
#cd /usr/samba/smbbin-3.0.30/
#./start_smb &




/bin/pm_daemon &

clear_config_files

wsagent_start

thttpd -l /disk/www/log.txt  -C /disk/www/thttpd.conf
